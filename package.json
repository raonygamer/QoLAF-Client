{
  "name": "qolaf-client",
  "version": "0.3.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "preview": "node scripts/Preview.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "node scripts/build.mjs",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "esbuild": "0.25.12",
    "linkedom": "0.18.15",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
